  <div class="nav-inner">
    <div class="nav-logo">
      <div class="om-symbol">🕉</div>
      <div class="logo-text">
        <span class="logo-hi">हिंदू स्वराज पार्टी</span>
        <span class="logo-en">HINDU SWARAJ PARTY</span>
      </div>
    </div>
    <nav class="nav-links">
      <a href="#home">Home</a>
      <a href="#about">About</a>
      <a href="#ideology">Ideology</a>
      <a href="#savarkar">Veer Savarkar</a>
      <a href="#agenda">Agenda</a>
