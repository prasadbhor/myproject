<!-- ========== HERO ========== -->
<section class="hero" id="home">
  <div class="hero-bg-pattern"></div>
  <div class="hero-lotus-left">🪷</div>
  <div class="hero-lotus-right">🪷</div>
  <div class="hero-content">
    <div class="hero-badge">॥ सत्यमेव जयते ॥</div>
    <h1 class="hero-title">
      <span class="hero-hi">हिंदू स्वराज पार्टी</span>
      <span class="hero-en">HINDU SWARAJ PARTY</span>
    </h1>
    <p class="hero-tagline">धर्म रक्षति रक्षितः — <em>He who protects Dharma is protected by Dharma</em></p>
    <p class="hero-sub">A political movement rooted in the timeless values of Sanatan Dharma, dedicated to the prosperity, pride, and protection of every Hindu and every Indian.</p>
    <div class="hero-btns">
      <button class="btn-primary" onclick="document.getElementById('join').scrollIntoView({behavior:'smooth'})">🙏 Join the Movement</button>
      <button class="btn-outline" onclick="document.getElementById('about').scrollIntoView({behavior:'smooth'})">Learn More ↓</button>
    </div>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-num" id="memberCountHero"><%= memberCount %>+</span>
        <span class="stat-label">Members</span>
      </div>
      <div class="stat-divider">|</div>
      <div class="stat">
        <span class="stat-num">2024</span>
        <span class="stat-label">Founded</span>
      </div>
      <div class="stat-divider">|</div>
      <div class="stat">
        <span class="stat-num">28</span>
        <span class="stat-label">States Active</span>
      </div>
    </div>
  </div>
  <div class="hero-scroll-hint">↓ Scroll to explore</div>
</section>

<!-- ========== SAFFRON STRIP ========== -->
<div class="tricolor-strip">
  <div class="strip-saffron"></div>
  <div class="strip-white"><span>🕉️ हर हर महादेव 🕉️ &nbsp;&nbsp;&nbsp; जय माँ भारती &nbsp;&nbsp;&nbsp; वन्दे मातरम्</span></div>
  <div class="strip-green"></div>
</div>

<!-- ========== ABOUT ========== -->
<section class="section about-section" id="about">
  <div class="container">
    <div class="section-eyebrow">॥ परिचय ॥</div>
    <h2 class="section-title">About Hindu Swaraj Party</h2>
    <div class="about-grid">
      <div class="about-text">
        <p>Hindu Swaraj Party is a democratic political organization born from the sacred duty to uphold <strong>Sanatan Dharma</strong>, protect the cultural heritage of Bharat, and ensure the dignity and rights of every Hindu citizen across the nation.</p>
        <p>We believe in a <strong>self-reliant, spiritually rooted, and economically strong Bharat</strong> — one that walks the ancient path of Dharma while embracing the modern world with confidence and pride.</p>
        <p>Our party is committed to <strong>inclusive governance</strong>, respect for all traditions, protection of temples and sacred places, promotion of Sanskrit and Vedic education, and the economic empowerment of every citizen.</p>
        <div class="about-values">
          <div class="value-card"><div class="value-icon">🪷</div><h4>Dharma</h4><p>Righteousness in every action</p></div>
          <div class="value-card"><div class="value-icon">🔱</div><h4>Shakti</h4><p>Strength of nation & people</p></div>
          <div class="value-card"><div class="value-icon">🕉</div><h4>Satya</h4><p>Truth as the ultimate guide</p></div>
          <div class="value-card"><div class="value-icon">🌸</div><h4>Seva</h4><p>Service above all else</p></div>
        </div>
      </div>
      <div class="about-visual">
        <div class="about-emblem">
          <div class="emblem-ring">
            <div class="emblem-center">
              <div class="emblem-om">🕉</div>
              <div class="emblem-text">हिंदू स्वराज</div>
            </div>
          </div>
          <div class="emblem-caption">Party Emblem</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ========== IDEOLOGY ========== -->
<section class="section ideology-section" id="ideology">
  <div class="container">
    <div class="section-eyebrow">॥ विचारधारा ॥</div>
    <h2 class="section-title">Our Ideology</h2>
    <p class="section-subtitle">Rooted in the eternal wisdom of Sanatan Dharma, guided by the vision of a great Bharat</p>
    <div class="ideology-grid">
      <div class="ideology-card">
        <div class="ideo-icon">🛕</div>
        <h3>Temple & Heritage Protection</h3>
        <p>Reclaim, restore, and protect ancient Hindu temples and sacred sites across Bharat from any form of encroachment or desecration.</p>
      </div>
      <div class="ideology-card">
        <div class="ideo-icon">📖</div>
        <h3>Vedic Education</h3>
        <p>Integrate Vedic wisdom, Sanskrit language, and yogic sciences into the modern education system to build character along with knowledge.</p>
      </div>
      <div class="ideology-card">
        <div class="ideo-icon">🌾</div>
        <h3>Farmers & Rural Empowerment</h3>
        <p>Strengthen the backbone of Bharat — our Annadatas — through fair prices, debt relief, and modern agricultural support.</p>
      </div>
      <div class="ideology-card">
        <div class="ideo-icon">⚖️</div>
        <h3>Uniform Civil Code</h3>
        <p>One nation, one law. Advocate for equal rights for every citizen, ending discrimination based on personal law differences.</p>
      </div>
      <div class="ideology-card">
        <div class="ideo-icon">🇮🇳</div>
        <h3>Cultural Nationalism</h3>
        <p>Celebrate the glorious culture of Bharat, promote Hindi and regional languages, and strengthen our civilizational identity.</p>
      </div>
      <div class="ideology-card">
        <div class="ideo-icon">💪</div>
        <h3>Economic Sovereignty</h3>
        <p>Swadeshi first — support Indian businesses, MSMEs, and entrepreneurs while building a self-reliant economic superpower.</p>
      </div>
    </div>
  </div>
</section>

<!-- ========== VEER SAVARKAR SECTION (replaces president) ========== -->
<section class="section savarkar-section" id="savarkar">
  <div class="savarkar-bg-overlay"></div>
  <div class="container">
    <div class="section-eyebrow savarkar-eyebrow">॥ स्वातंत्र्यवीर ॥</div>
    <h2 class="section-title savarkar-title">Veer Savarkar — Our Ideological Inspiration</h2>
    <p class="section-subtitle savarkar-sub">The fearless champion of Hindu Rashtra, revolutionary freedom fighter, and philosopher of Hindutva</p>

    <div class="savarkar-main-card">
      <!-- LEFT: Photo -->
      <div class="savarkar-photo-col">
        <div class="savarkar-photo-frame">
          <img
            src="https://upload.wikimedia.org/wikipedia/commons/thumb/7/7a/Veer_Savarkar.jpg/400px-Veer_Savarkar.jpg"
            alt="Veer Savarkar — Swatantryaveer Vinayak Damodar Savarkar"
            class="savarkar-photo"
            onerror="this.src='https://upload.wikimedia.org/wikipedia/commons/thumb/a/ac/No_image_available.svg/200px-No_image_available.svg.png'"
          />
          <div class="savarkar-photo-badge">स्वातंत्र्यवीर</div>
        </div>
        <div class="savarkar-name-block">
          <h3 class="savarkar-name">Vinayak Damodar Savarkar</h3>
          <p class="savarkar-dates">28 May 1883 – 26 February 1966</p>
          <div class="savarkar-tags">
            <span>🔱 Hindutva Philosopher</span>
            <span>✊ Freedom Fighter</span>
            <span>📜 Author & Poet</span>
          </div>
        </div>
      </div>

      <!-- RIGHT: Details -->
      <div class="savarkar-info-col">
        <blockquote class="savarkar-quote">
          <span class="quote-mark">"</span>
          If you cut my body into pieces, every piece would cry — <em>Jai Hind! Jai Bharat!</em>
          <span class="quote-mark">"</span>
        </blockquote>

        <div class="savarkar-bio">
          <p>
            <strong>Vinayak Damodar Savarkar</strong>, known as <strong>Veer Savarkar</strong> (Brave Savarkar), was one of India's most fearless revolutionary freedom fighters, a brilliant orator, poet, and the father of the Hindutva ideology. He was the first political prisoner to be held in the infamous Cellular Jail (Kala Pani) in the Andaman Islands, where he endured extreme torture yet never broke his spirit.
          </p>
          <p>
            His seminal work <em>"Hindutva: Who is a Hindu?"</em> (1923) defined the concept of Hindu nationalism and laid the philosophical foundation that inspires our party's vision of a culturally proud, spiritually rooted Bharat.
          </p>
        </div>

        <!-- Ideology Pillars -->
        <div class="savarkar-pillars">
          <h4 class="pillars-heading">🔱 Core Philosophical Pillars</h4>
          <div class="pillars-grid">
            <div class="pillar-card">
              <div class="pillar-icon">📜</div>
              <h5>Hindutva</h5>
              <p>Defined Hinduness as a civilizational identity — not just a religion, but a way of life for all born of Bharatmata.</p>
            </div>
            <div class="pillar-card">
              <div class="pillar-icon">⚔️</div>
              <h5>Armed Resistance</h5>
              <p>Championed the right of Hindus to bear arms and defend themselves, advocating militarization of the Hindu community.</p>
            </div>
            <div class="pillar-card">
              <div class="pillar-icon">🔬</div>
              <h5>Scientific Temper</h5>
              <p>Advocated blending Hindu tradition with modern science, rejecting superstition while honoring cultural heritage.</p>
            </div>
            <div class="pillar-card">
              <div class="pillar-icon">🤝</div>
              <h5>Social Reform</h5>
              <p>Strongly opposed untouchability and caste discrimination. Believed in a united, casteless Hindu society.</p>
            </div>
            <div class="pillar-card">
              <div class="pillar-icon">🌐</div>
              <h5>Hindu Rashtra</h5>
              <p>Envisioned Bharat as a Hindu Rashtra — a nation where Hindu culture, values, and heritage form the civilizational core.</p>
            </div>
            <div class="pillar-card">
              <div class="pillar-icon">🕊️</div>
              <h5>Absolute Independence</h5>
              <p>Was the first to call for <em>Purna Swaraj</em> (complete independence) from British rule as early as 1900.</p>
            </div>
          </div>
        </div>

        <!-- Key Facts Timeline -->
        <div class="savarkar-timeline">
          <h4 class="pillars-heading">📅 Life & Legacy — Key Milestones</h4>
          <div class="timeline-list">
            <div class="tl-item"><span class="tl-year">1883</span><span class="tl-event">Born in Bhagur, Nashik, Maharashtra</span></div>
            <div class="tl-item"><span class="tl-year">1900</span><span class="tl-event">Founded secret society <em>Mitra Mela</em> (later Abhinav Bharat Society)</span></div>
            <div class="tl-item"><span class="tl-year">1909</span><span class="tl-event">Arrested in London for revolutionary activities against British rule</span></div>
            <div class="tl-item"><span class="tl-year">1911</span><span class="tl-event">Sentenced to 50 years — sent to Cellular Jail, Andaman (Kala Pani)</span></div>
            <div class="tl-item"><span class="tl-year">1923</span><span class="tl-event">Wrote <em>Hindutva: Who is a Hindu?</em> — defining text of Hindu nationalism</span></div>
            <div class="tl-item"><span class="tl-year">1937</span><span class="tl-event">Elected President of Hindu Mahasabha</span></div>
            <div class="tl-item"><span class="tl-year">1966</span><span class="tl-event">Attained Mahasamadhi on 26 February, Mumbai</span></div>
            <div class="tl-item"><span class="tl-year">2024</span><span class="tl-event">Bharat Ratna conferred posthumously — nation honours its greatest patriot</span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- VIDEO SECTION -->
    <div class="savarkar-video-section">
      <h3 class="video-heading">🎬 Know More About Veer Savarkar</h3>
      <p class="video-sub">Watch this documentary to understand the life, philosophy, and legacy of Swatantryaveer Vinayak Damodar Savarkar</p>
      <div class="video-frame-wrap">
        <iframe
          class="savarkar-video"
          src="https://www.youtube.com/embed/qcC5zU6fKpM"
          title="Veer Savarkar - Life and Legacy"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
      <p class="video-caption">📺 Swatantryaveer Savarkar — The Revolutionary Hero of India</p>
    </div>
  </div>
</section>

<!-- ========== AGENDA / MANIFESTO ========== -->
<section class="section agenda-section" id="agenda">
  <div class="container">
    <div class="section-eyebrow">॥ हमारा संकल्प ॥</div>
    <h2 class="section-title">Our Agenda & Manifesto</h2>
    <p class="section-subtitle">Five pillars of our commitment to the people of Bharat</p>
    <div class="agenda-list">
      <div class="agenda-item">
        <div class="agenda-num">०१</div>
        <div class="agenda-content">
          <h3>Protect Sanatan Dharma</h3>
          <p>Enact strong legal protections for Hindu temples, pilgrimage sites, and religious practices. End discrimination against Hindu festivals and traditions.</p>
        </div>
      </div>
      <div class="agenda-item">
        <div class="agenda-num">०२</div>
        <div class="agenda-content">
          <h3>Ram Rajya Governance</h3>
          <p>Transparent, corruption-free governance inspired by the ideals of Ram Rajya — where every citizen is heard, protected, and empowered.</p>
        </div>
      </div>
      <div class="agenda-item">
        <div class="agenda-num">०३</div>
        <div class="agenda-content">
          <h3>Youth & Education Reform</h3>
          <p>Revamp education to include Vedic sciences, yoga, martial arts, and Indian history — building confident, rooted, and skilled citizens.</p>
        </div>
      </div>
      <div class="agenda-item">
        <div class="agenda-num">०४</div>
        <div class="agenda-content">
          <h3>Women Safety & Dignity</h3>
          <p>Zero tolerance for crimes against women. Fast-track courts, stronger laws, and community programs ensuring safety for every daughter of Bharat.</p>
        </div>
      </div>
      <div class="agenda-item">
        <div class="agenda-num">०५</div>
        <div class="agenda-content">
          <h3>Viksit Bharat 2047</h3>
          <p>Work toward a fully developed India by 2047 — with world-class infrastructure, healthcare, space capabilities, and global cultural leadership.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ========== COMMUNITY — WhatsApp & Telegram ========== -->
<section class="section community-section" id="community">
  <div class="community-bg"></div>
  <div class="container">
    <div class="section-eyebrow" style="color:#FFD700">॥ हमारे समुदाय से जुड़ें ॥</div>
    <h2 class="section-title" style="color:#fff">Join Our Community</h2>
    <p class="section-subtitle" style="color:#FFD700aa">Connect with thousands of like-minded patriots on WhatsApp & Telegram</p>

    <div class="community-cards">
      <!-- WhatsApp Card -->
      <div class="comm-card whatsapp-card">
        <div class="comm-icon">
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48">
            <circle cx="16" cy="16" r="16" fill="#25D366"/>
            <path d="M22.5 9.5A8.96 8.96 0 0016 7C11.03 7 7 11.03 7 16c0 1.59.42 3.14 1.21 4.5L7 25l4.62-1.21A8.96 8.96 0 0016 25c4.97 0 9-4.03 9-9 0-2.41-.94-4.67-2.5-6.5zm-6.5 13.83c-1.35 0-2.67-.36-3.82-1.03l-.27-.16-2.74.72.73-2.67-.18-.28A7.42 7.42 0 018.58 16c0-4.1 3.34-7.44 7.44-7.44 1.99 0 3.86.78 5.27 2.18A7.41 7.41 0 0123.5 16c-.01 4.1-3.35 7.33-7.5 7.33zm4.08-5.56c-.22-.11-1.32-.65-1.52-.72-.2-.08-.35-.11-.5.11-.15.22-.57.72-.7.87-.13.15-.26.17-.48.06-.22-.11-.94-.35-1.79-1.11-.66-.59-1.1-1.32-1.23-1.54-.13-.22-.01-.34.1-.45.1-.1.22-.26.33-.39.11-.13.15-.22.22-.37.08-.15.04-.28-.02-.39-.06-.11-.5-1.21-.69-1.66-.18-.43-.37-.37-.5-.38h-.43c-.15 0-.39.06-.59.28-.2.22-.78.76-.78 1.85s.8 2.15.91 2.3c.11.15 1.57 2.4 3.8 3.36.53.23.94.37 1.27.47.53.17 1.02.14 1.4.09.43-.06 1.32-.54 1.5-1.06.19-.52.19-.96.13-1.06-.05-.1-.2-.16-.42-.27z" fill="white"/>
          </svg>
        </div>
        <h3 class="comm-title">WhatsApp Group</h3>
        <p class="comm-desc">Join our official WhatsApp group to get daily updates, rally announcements, and connect with party members.</p>
        <div class="comm-stats">
          <span id="wa-members">Loading...</span>
        </div>
        <button class="comm-btn wa-btn" id="waJoinBtn" onclick="joinCommunity('whatsapp')">
          <span class="btn-spinner" id="wa-spinner" style="display:none"></span>
          Join WhatsApp Group →
        </button>
        <div class="comm-status" id="wa-status"></div>
      </div>

      <!-- Telegram Card -->
      <div class="comm-card telegram-card">
        <div class="comm-icon">
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48">
            <circle cx="16" cy="16" r="16" fill="#229ED9"/>
            <path d="M23.5 8.5L5.5 15.6c-1.2.5-1.2 1.2-.2 1.5l4.5 1.4 10.4-6.6c.5-.3.9-.1.6.2l-8.4 7.6v0l-.3 4.7c.4 0 .6-.2.8-.4l2-1.9 4.1 3c.8.4 1.3.2 1.5-.7l2.7-12.8c.3-1.2-.5-1.7-1.2-1.6z" fill="white"/>
          </svg>
        </div>
        <h3 class="comm-title">Telegram Channel</h3>
        <p class="comm-desc">Subscribe to our Telegram channel for news, ideology discussions, party policies, and member-only content.</p>
        <div class="comm-stats">
          <span id="tg-members">Loading...</span>
        </div>
        <button class="comm-btn tg-btn" id="tgJoinBtn" onclick="joinCommunity('telegram')">
          <span class="btn-spinner" id="tg-spinner" style="display:none"></span>
          Join Telegram Channel →
        </button>
        <div class="comm-status" id="tg-status"></div>
      </div>

      <!-- YouTube Card -->
      <div class="comm-card youtube-card">
        <div class="comm-icon">
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48">
            <circle cx="16" cy="16" r="16" fill="#FF0000"/>
            <path d="M24.5 12.5s-.2-1.5-.9-2.1c-.8-.9-1.8-.9-2.2-.9C18.8 9.3 16 9.3 16 9.3s-2.8 0-5.4.2c-.4.1-1.4.1-2.2.9-.7.6-.9 2.1-.9 2.1S7.3 14.2 7.3 16v1.4c0 1.8.2 3.5.2 3.5s.2 1.5.9 2.1c.8.9 2 .8 2.5.9 1.8.2 7.1.2 7.1.2s2.8 0 5.4-.2c.4-.1 1.4-.1 2.2-.9.7-.6.9-2.1.9-2.1s.2-1.7.2-3.5V16c0-1.8-.2-3.5-.2-3.5zm-13.1 7.1v-6.2l6 3.1-6 3.1z" fill="white"/>
          </svg>
        </div>
        <h3 class="comm-title">YouTube Channel</h3>
        <p class="comm-desc">Watch speeches, rallies, documentaries about Hindu history, and Savarkar's philosophy on our YouTube channel.</p>
        <div class="comm-stats">
          <span id="yt-members">Loading...</span>
        </div>
        <button class="comm-btn yt-btn" id="ytJoinBtn" onclick="joinCommunity('youtube')">
          <span class="btn-spinner" id="yt-spinner" style="display:none"></span>
          Subscribe on YouTube →
        </button>
        <div class="comm-status" id="yt-status"></div>
      </div>
    </div>

    <!-- API Status Dashboard -->
    <div class="api-dashboard">
      <h4 class="api-dash-title">🔗 Live Community API Status</h4>
      <div class="api-status-grid" id="apiStatusGrid">
        <div class="api-stat-item" id="api-health"><span class="api-dot loading"></span> Health Check</div>
        <div class="api-stat-item" id="api-members"><span class="api-dot loading"></span> Members API</div>
        <div class="api-stat-item" id="api-wa"><span class="api-dot loading"></span> WhatsApp API</div>
        <div class="api-stat-item" id="api-tg"><span class="api-dot loading"></span> Telegram API</div>
      </div>
    </div>
  </div>
</section>

<!-- ========== JOIN US ========== -->
<section class="section join-section" id="join">
  <div class="join-bg-pattern"></div>
  <div class="container">
    <div class="section-eyebrow">॥ हमसे जुड़ें ॥</div>
    <h2 class="section-title">Join Hindu Swaraj Party</h2>
    <p class="section-subtitle">Be part of the movement. Fill in your details below and become a proud member of Hindu Swaraj Party.</p>

    <% if (success) { %>
    <div class="alert alert-success">
      <span class="alert-icon">✅</span>
      <%= success %>
    </div>
    <% } %>

    <% if (error) { %>
    <div class="alert alert-error">
      <span class="alert-icon">⚠️</span>
      <%= error %>
    </div>
    <% } %>

    <div class="join-wrapper">
      <div class="join-info">
        <div class="join-info-icon">🕉</div>
        <h3>Why Join Us?</h3>
        <ul class="join-benefits">
          <li>✅ Be part of a growing national movement</li>
          <li>✅ Participate in events, rallies & campaigns</li>
          <li>✅ Help shape the future of Bharat</li>
          <li>✅ Connect with like-minded patriots</li>
          <li>✅ Receive official party membership card</li>
          <li>✅ Get updates directly from party leadership</li>
        </ul>
        <div class="join-member-count">
          <span class="jmc-num"><%= memberCount %>+</span>
          <span class="jmc-label">Members have already joined</span>
        </div>
      </div>
      <form class="join-form" action="/join" method="POST" id="joinForm">
        <div class="form-header">
          <h3>Membership Registration</h3>
          <p>सदस्यता पंजीकरण</p>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Full Name <span class="req">*</span></label>
            <input type="text" name="full_name" placeholder="Enter your full name" required/>
          </div>
          <div class="form-group">
            <label>Email Address <span class="req">*</span></label>
            <input type="email" name="email" placeholder="your@email.com" required/>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Mobile Number <span class="req">*</span></label>
            <input type="tel" name="phone" placeholder="+91 XXXXX XXXXX" required/>
          </div>
          <div class="form-group">
            <label>Occupation</label>
            <select name="occupation">
              <option value="">Select Occupation</option>
              <option>Student</option>
              <option>Farmer</option>
              <option>Business / Vyapar</option>
              <option>Government Service</option>
              <option>Private Service</option>
              <option>Social Worker</option>
              <option>Religious Leader</option>
              <option>Retired</option>
              <option>Other</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>City / Village <span class="req">*</span></label>
            <input type="text" name="city" placeholder="Your city or village" required/>
          </div>
          <div class="form-group">
            <label>State <span class="req">*</span></label>
            <select name="state" required>
              <option value="">Select State</option>
              <option>Andhra Pradesh</option><option>Arunachal Pradesh</option>
              <option>Assam</option><option>Bihar</option><option>Chhattisgarh</option>
              <option>Goa</option><option>Gujarat</option><option>Haryana</option>
              <option>Himachal Pradesh</option><option>Jharkhand</option>
              <option>Karnataka</option><option>Kerala</option>
              <option>Madhya Pradesh</option><option selected>Maharashtra</option>
              <option>Manipur</option><option>Meghalaya</option>
              <option>Mizoram</option><option>Nagaland</option>
              <option>Odisha</option><option>Punjab</option>
              <option>Rajasthan</option><option>Sikkim</option>
              <option>Tamil Nadu</option><option>Telangana</option>
              <option>Tripura</option><option>Uttar Pradesh</option>
              <option>Uttarakhand</option><option>West Bengal</option>
              <option>Delhi</option><option>Jammu & Kashmir</option>
            </select>
          </div>
        </div>
        <div class="form-group full-width">
          <label>Your Message / Why you want to join</label>
          <textarea name="message" rows="3" placeholder="Share why you wish to join Hindu Swaraj Party..."></textarea>
        </div>
        <div class="form-declaration">
          <input type="checkbox" id="declaration" required/>
          <label for="declaration">I declare that I believe in the Constitution of India, and I wish to join Hindu Swaraj Party voluntarily to serve Dharma and the nation.</label>
        </div>
        <button type="submit" class="form-submit-btn">
          🙏 Submit Membership &nbsp; | &nbsp; सदस्य बनें
        </button>
      </form>
    </div>
  </div>
</section>

