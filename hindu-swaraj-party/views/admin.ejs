<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Dashboard — Hindu Swaraj Party</title>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    body { font-family: 'Inter', sans-serif; background:#0a0a0a; color:#e8e8e8; min-height:100vh; }

    /* ---- TOP BAR ---- */
    .topbar {
      background:#111;
      border-bottom: 2px solid #FF9933;
      padding: 0 1.5rem;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky; top:0; z-index:100;
    }
    .topbar-left { display:flex; align-items:center; gap:1rem; }
    .topbar-om { font-size:1.6rem; filter:drop-shadow(0 0 8px #FFD700); }
    .topbar-title { font-family:'Cinzel',serif; color:#FF9933; font-size:1rem; font-weight:700; }
    .topbar-sub { color:#555; font-size:0.75rem; }
    .topbar-right { display:flex; gap:0.8rem; align-items:center; flex-wrap:wrap; }
    .admin-badge { background:#1a1a1a; border:1px solid #333; color:#FFD700; border-radius:20px; padding:4px 12px; font-size:0.78rem; }

    /* ---- BUTTONS ---- */
    .btn { display:inline-flex; align-items:center; gap:6px; font-weight:600; padding:7px 16px; border-radius:6px; text-decoration:none; font-size:0.82rem; transition:opacity .2s; cursor:pointer; border:none; font-family:'Inter',sans-serif; }
    .btn-primary { background:#FF9933; color:#000; }
    .btn-primary:hover { opacity:.85; }
    .btn-outline { background:transparent; border:1px solid #FF9933; color:#FF9933; }
    .btn-outline:hover { background:#FF993318; }
    .btn-danger { background:transparent; border:1px solid #800000; color:#ff6b6b; }
    .btn-danger:hover { background:#80000018; }

    /* ---- MAIN LAYOUT ---- */
    .main { padding: 1.5rem; max-width:1400px; margin:0 auto; }

    /* ---- STATS CARDS ---- */
    .stats-row { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:1rem; margin-bottom:1.5rem; }
    .stat-card {
      background:#141414;
      border:1px solid #222;
      border-radius:12px;
      padding:1.2rem 1.5rem;
      border-left:3px solid var(--accent, #FF9933);
    }
    .stat-card .sc-label { font-size:0.75rem; color:#666; text-transform:uppercase; letter-spacing:.05em; }
    .stat-card .sc-value { font-size:2rem; font-weight:700; color:var(--accent,#FF9933); margin-top:4px; font-family:'Cinzel',serif; }
    .stat-card .sc-sub { font-size:0.75rem; color:#555; margin-top:2px; }

    /* ---- TOOLBAR ---- */
    .toolbar { display:flex; gap:0.8rem; align-items:center; flex-wrap:wrap; margin-bottom:1rem; }
    .search-input {
      background:#141414; border:1px solid #2c2c2c; color:#eee;
      padding:8px 14px; border-radius:8px; font-size:0.88rem; outline:none;
      min-width:260px; transition:border-color .2s;
    }
    .search-input:focus { border-color:#FF9933; }

    /* ---- TABLE ---- */
    .table-wrap { overflow-x:auto; border-radius:10px; border:1px solid #1e1e1e; }
    table { width:100%; border-collapse:collapse; background:#111; min-width:750px; }
    th { background:linear-gradient(90deg,#800000,#5C0000); color:#FFD700; padding:12px 14px; text-align:left; font-size:0.75rem; text-transform:uppercase; letter-spacing:.05em; white-space:nowrap; font-weight:600; }
    td { padding:10px 14px; border-bottom:1px solid #1a1a1a; font-size:0.84rem; vertical-align:middle; }
    tr:hover td { background:#171717; }
    tr:last-child td { border-bottom:none; }
    .badge { display:inline-block; background:#1a0000; color:#FF9933; border-radius:4px; padding:2px 8px; font-size:0.73rem; border:1px solid #800000; }
    .no-data { text-align:center; padding:3rem; color:#555; }

    /* ---- API STATUS ---- */
    .api-panel { background:#111; border:1px solid #1e1e1e; border-radius:12px; padding:1.2rem; margin-bottom:1.5rem; }
    .api-panel-title { color:#FF9933; font-size:0.85rem; font-weight:600; margin-bottom:0.8rem; }
    .api-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:0.6rem; }
    .api-item { background:#0d0d0d; border:1px solid #1e1e1e; border-radius:8px; padding:0.7rem 1rem; display:flex; align-items:center; gap:0.5rem; font-size:0.78rem; }
    .dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
    .dot.green { background:#22c55e; box-shadow:0 0 6px #22c55e; }
    .dot.red { background:#ef4444; box-shadow:0 0 6px #ef4444; }
    .dot.orange { background:#f59e0b; box-shadow:0 0 6px #f59e0b; animation:pulse 1s infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }

    /* ---- FOOTER ---- */
    .page-footer { margin-top:2rem; color:#333; font-size:0.78rem; text-align:center; border-top:1px solid #1a1a1a; padding-top:1rem; }

    @media(max-width:640px) { .topbar-title { font-size:0.85rem; } .main { padding:1rem; } .stats-row { grid-template-columns:1fr 1fr; } }
  </style>
</head>
<body>

<!-- TOP BAR -->
<div class="topbar">
  <div class="topbar-left">
    <span class="topbar-om">🕉</span>
    <div>
      <div class="topbar-title">ADMIN DASHBOARD</div>
      <div class="topbar-sub">Hindu Swaraj Party — Member Registry</div>
    </div>
  </div>
  <div class="topbar-right">
    <span class="admin-badge">👤 <%= adminUser %></span>
    <a href="/admin/members/export" class="btn btn-primary" download>⬇ Export CSV</a>
    <a href="/" class="btn btn-outline" target="_blank">🌐 View Site</a>
    <a href="/admin/logout" class="btn btn-danger">🚪 Logout</a>
  </div>
</div>

<div class="main">

  <!-- STATS -->
  <div class="stats-row">
    <div class="stat-card" style="--accent:#FF9933">
      <div class="sc-label">Total Members</div>
      <div class="sc-value"><%= members.length %></div>
      <div class="sc-sub">Registered Members</div>
    </div>
    <div class="stat-card" style="--accent:#22c55e">
      <div class="sc-label">Today's New</div>
      <div class="sc-value"><%= todayCount %></div>
      <div class="sc-sub">Joined today</div>
    </div>
    <div class="stat-card" style="--accent:#FFD700">
      <div class="sc-label">This Month</div>
      <div class="sc-value"><%= monthCount %></div>
      <div class="sc-sub">This month's joins</div>
    </div>
    <div class="stat-card" style="--accent:#229ED9">
      <div class="sc-label">States Covered</div>
      <div class="sc-value"><%= stateCount %></div>
      <div class="sc-sub">States represented</div>
    </div>
  </div>

  <!-- API STATUS PANEL -->
  <div class="api-panel">
    <div class="api-panel-title">🔗 API Health Monitor</div>
    <div class="api-grid" id="apiGrid">
      <div class="api-item"><span class="dot orange" id="dot-health"></span><span id="lbl-health">Health API…</span></div>
      <div class="api-item"><span class="dot orange" id="dot-members"></span><span id="lbl-members">Members API…</span></div>
      <div class="api-item"><span class="dot orange" id="dot-wa"></span><span id="lbl-wa">WhatsApp API…</span></div>
      <div class="api-item"><span class="dot orange" id="dot-tg"></span><span id="lbl-tg">Telegram API…</span></div>
      <div class="api-item"><span class="dot orange" id="dot-stats"></span><span id="lbl-stats">Stats API…</span></div>
    </div>
  </div>

  <!-- TOOLBAR -->
  <div class="toolbar">
    <input type="text" class="search-input" id="searchInput" placeholder="🔍 Search name, email, city, state…" oninput="filterTable()"/>
    <select id="stateFilter" class="search-input" style="min-width:160px" onchange="filterTable()">
      <option value="">All States</option>
      <% const states = [...new Set(members.map(m=>m.state).filter(Boolean))].sort(); %>
      <% states.forEach(s => { %><option value="<%= s %>"><%= s %></option><% }) %>
    </select>
  </div>

  <!-- TABLE -->
  <div class="table-wrap">
    <table id="membersTable">
      <thead>
        <tr>
          <th>#</th><th>Name</th><th>Email</th><th>Phone</th>
          <th>City</th><th>State</th><th>Occupation</th><th>Joined</th>
        </tr>
      </thead>
      <tbody>
        <% if (members.length === 0) { %>
        <tr><td colspan="8" class="no-data">🪷 No members registered yet.</td></tr>
        <% } else { %>
        <% members.forEach((m, i) => { %>
        <tr>
          <td style="color:#555"><%= i+1 %></td>
          <td><strong style="color:#FF9933"><%= m.full_name %></strong></td>
          <td style="color:#aaa"><%= m.email %></td>
          <td><%= m.phone %></td>
          <td><%= m.city %></td>
          <td><span class="badge"><%= m.state %></span></td>
          <td style="color:#888"><%= m.occupation || '—' %></td>
          <td style="color:#555"><%= new Date(m.createdAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></td>
        </tr>
        <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="page-footer">🕉 Hindu Swaraj Party — Admin Panel &nbsp;|&nbsp; जय हिंद 🇮🇳 &nbsp;|&nbsp; Inspired by Veer Savarkar</div>
</div>

<script>
function filterTable() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const sf = document.getElementById('stateFilter').value.toLowerCase();
  document.querySelectorAll('#membersTable tbody tr').forEach(row => {
    const text = row.textContent.toLowerCase();
    const matchQ = !q || text.includes(q);
    const matchS = !sf || text.includes(sf);
    row.style.display = (matchQ && matchS) ? '' : 'none';
  });
}

// API health checks
async function checkApis() {
  const checks = [
    { id: 'health',   url: '/health',              label: 'Health API' },
    { id: 'members',  url: '/api/members/count',   label: 'Members API' },
    { id: 'wa',       url: '/api/community/whatsapp', label: 'WhatsApp API' },
    { id: 'tg',       url: '/api/community/telegram', label: 'Telegram API' },
    { id: 'stats',    url: '/api/stats',            label: 'Stats API' },
  ];
  for (const c of checks) {
    try {
      const r = await fetch(c.url);
      const ok = r.ok;
      document.getElementById('dot-'+c.id).className = 'dot ' + (ok ? 'green' : 'red');
      document.getElementById('lbl-'+c.id).textContent = c.label + (ok ? ' ✓' : ' ✗');
    } catch {
      document.getElementById('dot-'+c.id).className = 'dot red';
      document.getElementById('lbl-'+c.id).textContent = c.label + ' ✗';
    }
  }
}
checkApis();
setInterval(checkApis, 30000);
</script>
</body>
</html>
