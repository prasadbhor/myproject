<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin — Members | Hindu Swaraj Party</title>
  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    body { font-family: 'Segoe UI', Arial, sans-serif; background:#0d0d0d; color:#e8e8e8; padding:2rem; min-height:100vh; }
    .header { display:flex; align-items:center; justify-content:space-between; margin-bottom:2rem; flex-wrap:wrap; gap:1rem; }
    h1 { color:#FF9933; font-size:1.5rem; }
    .meta { display:flex; gap:1rem; align-items:center; flex-wrap:wrap; }
    .count-badge { background:#1a1a1a; border:1px solid #FF9933; color:#FFD700; border-radius:20px; padding:6px 16px; font-size:0.9rem; }
    .btn { display:inline-flex; align-items:center; gap:6px; background:#FF9933; color:#000; font-weight:600; padding:8px 18px; border-radius:6px; text-decoration:none; font-size:0.85rem; transition:opacity .2s; cursor:pointer; border:none; }
    .btn:hover { opacity:.85; }
    .btn-outline { background:transparent; border:1px solid #FF9933; color:#FF9933; }
    .btn-outline:hover { background:#FF993320; }
    .search-bar { width:100%; margin-bottom:1.5rem; }
    .search-bar input { width:100%; max-width:400px; background:#1a1a1a; border:1px solid #333; color:#eee; padding:10px 14px; border-radius:8px; font-size:0.9rem; outline:none; }
    .search-bar input:focus { border-color:#FF9933; }
    .table-wrap { overflow-x:auto; border-radius:10px; border:1px solid #222; }
    table { width:100%; border-collapse:collapse; background:#111; min-width:700px; }
    th { background:#FF9933; color:#000; padding:12px 14px; text-align:left; font-size:0.8rem; text-transform:uppercase; letter-spacing:.05em; white-space:nowrap; }
    td { padding:10px 14px; border-bottom:1px solid #1e1e1e; font-size:0.85rem; vertical-align:middle; }
    tr:hover td { background:#171717; }
    tr:last-child td { border-bottom:none; }
    .badge { display:inline-block; background:#800000; color:#FFD700; border-radius:4px; padding:2px 8px; font-size:0.75rem; }
    .no-data { text-align:center; padding:3rem; color:#666; }
    .footer { margin-top:2rem; color:#555; font-size:0.8rem; text-align:center; }
    @media(max-width:600px){ body{ padding:1rem; } h1{ font-size:1.2rem; } }
  </style>
</head>
<body>
  <div class="header">
    <h1>🕉 Hindu Swaraj Party — Member Registry</h1>
    <div class="meta">
      <span class="count-badge">Total: <strong><%= members.length %></strong></span>
      <a href="/admin/members/export?token=<%= token %>" class="btn">⬇ Export CSV</a>
      <a href="/" class="btn btn-outline">← Website</a>
    </div>
  </div>

  <div class="search-bar">
    <input type="text" id="searchInput" placeholder="🔍 Search by name, email, city, state…" oninput="filterTable()" />
  </div>

  <div class="table-wrap">
    <table id="membersTable">
      <thead>
        <tr>
          <th>#</th><th>Name</th><th>Email</th><th>Phone</th>
          <th>City</th><th>State</th><th>Occupation</th><th>Registered</th>
        </tr>
      </thead>
      <tbody>
        <% if (members.length === 0) { %>
        <tr><td colspan="8" class="no-data">No members registered yet.</td></tr>
        <% } else { %>
        <% members.forEach((m, i) => { %>
        <tr>
          <td><%= i+1 %></td>
          <td><strong><%= m.full_name %></strong></td>
          <td><%= m.email %></td>
          <td><%= m.phone %></td>
          <td><%= m.city %></td>
          <td><span class="badge"><%= m.state %></span></td>
          <td><%= m.occupation || '—' %></td>
          <td><%= new Date(m.createdAt).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) %></td>
        </tr>
        <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="footer">Hindu Swaraj Party — Admin Panel | जय हिंद 🇮🇳</div>

  <script>
    function filterTable() {
      const q = document.getElementById('searchInput').value.toLowerCase();
      document.querySelectorAll('#membersTable tbody tr').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
      });
    }
  </script>
</body>
</html>
